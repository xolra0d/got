const MAX_PEERS: usize = 100;

struct PeerStatus {
    choked: bool,
    interested: bool,
    has_pieces: Vec<bool>,
    active: bool,
}

impl Default for PeerStatus {
    fn default() -> Self {
        Self {
            choked: true,
            interested: false,
            has_pieces: vec![false; METAINFO.info.pieces.len()],
            active: true,
        }
    }
}

